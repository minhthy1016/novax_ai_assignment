# Copy to .env and adjust. Never commit .env.
# Values below are development defaults only; the API refuses to start in
# staging/prod while OPSASSIST_JWT_SECRET is still the dev sentinel.

OPSASSIST_ENV=dev
OPSASSIST_LOG_LEVEL=INFO
OPSASSIST_JWT_SECRET=dev-only-insecure-jwt-secret-change-me

POSTGRES_USER=opsassist
POSTGRES_PASSWORD=opsassist
POSTGRES_DB=opsassist
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=8000

# Runtime role: least privilege, NOT a superuser, so row-level security applies.
OPSASSIST_APP_DB_PASSWORD=opsassist_app_dev
# Used when running the API/tests on the host against the compose databases.
OPSASSIST_DATABASE_URL=postgresql+psycopg://opsassist_app:opsassist_app_dev@localhost:5432/opsassist
OPSASSIST_MIGRATION_DATABASE_URL=postgresql+psycopg://opsassist:opsassist@localhost:5432/opsassist
OPSASSIST_REDIS_URL=redis://localhost:6379/0

# Model providers. Real keys go in .env (gitignored) or your shell environment,
# NEVER in this file - it is committed. A provider without a key is disabled, and the
# stack still runs on local Ollama and (in dev/test) the deterministic mock provider.
# NVIDIA_API_KEY=
# ANTHROPIC_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434        # host runs; compose defaults to host.docker.internal
# OPSASSIST_ENABLE_MOCK_PROVIDER=               # default: on in dev/test, off otherwise
